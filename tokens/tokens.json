{
  "$description": "Toza v2 design tokens, Direction A (private bank). W3C Design Tokens (DTCG) format. Single source of colours, type, spacing and radii (V-037). styles/tokens.css is generated from this file by scripts/build-tokens.mjs; never edit it by hand. Alpha colours are CSS colour strings (rgb() with slash alpha) so the generated CSS is exact.",
  "$extensions": {
    "com.toza.css": {
      "note": "CSS variable name = '--' + path joined with '-' (a leaf named DEFAULT drops its suffix). A group with 'prefix' replaces its own path with that prefix. A token with 'emit: false' is documentation only. Composite typography tokens emit one variable per member: --type-<name>-<member>."
    }
  },

  "font": {
    "$type": "fontFamily",
    "$extensions": { "com.toza.css": { "quoted": ["Assistant", "Frank Ruhl Libre", "Segoe UI", "Times New Roman"] } },
    "sans": { "$value": ["Assistant", "system-ui", "Segoe UI", "Arial", "sans-serif"], "$description": "UI and body text. Self-hosted Assistant (latin + hebrew subsets)." },
    "body": { "$value": ["Assistant", "system-ui", "Segoe UI", "Arial", "sans-serif"], "$description": "Same stack as font.sans; Flowbite reads --font-body." },
    "serif": { "$value": ["Frank Ruhl Libre", "Times New Roman", "Georgia", "serif"], "$description": "Headings, numerals, stage labels. Self-hosted Frank Ruhl Libre (latin + hebrew subsets)." }
  },

  "color": {
    "$type": "color",

    "paper": { "$value": "#f7f2e8", "$description": "Warm ivory. Page background." },
    "paper-deep": { "$value": "#ede5d3", "$description": "Recessed ivory. Alternating sections, start card, bars." },
    "ink": { "$value": "#11302a", "$description": "Deep ink green. Headings, primary action, inverse sections." },
    "ink-soft": { "$value": "#1b4237", "$description": "Ink, one step lighter. Primary action hover." },
    "text": { "$value": "#1d2723", "$description": "Body text. Also the semantic text colour." },
    "muted": { "$value": "#525d57", "$description": "Secondary text. 6.3:1 on paper." },
    "brass": { "$value": "#7d5f24", "$description": "Accent. 5.2:1 on paper, text-safe." },
    "brass-light": { "$value": "#cfae6a", "$description": "Accent on ink. 7:1 on ink." },
    "rule": { "$value": "#cfc4aa", "$description": "Hairlines and borders on paper." },

    "doc-paper": { "$value": "#fffdf8", "$description": "Specimen document paper, lighter than the page." },
    "shadow-edge": { "$value": "rgb(0 0 0 / .04)", "$description": "Specimen document: 1px lower edge." },
    "shadow-ambient": { "$value": "rgb(17 48 42 / .35)", "$description": "Specimen document: soft ambient shadow (ink at 35%)." },
    "on-dark-border-strong": { "$value": "rgb(247 242 232 / .55)", "$description": "Ghost button border on ink (paper at 55%)." },
    "on-dark-text": { "$value": "rgb(247 242 232 / .88)", "$description": "Body copy on ink (paper at 88%)." },
    "on-dark-text-muted": { "$value": "rgb(247 242 232 / .75)", "$description": "Captions on ink (paper at 75%)." },
    "on-dark-rule": { "$value": "rgb(247 242 232 / .2)", "$description": "Hairlines on ink (paper at 20%)." },
    "action-inverse-hover": { "$value": "#ffffff", "$description": "Primary action on ink: hover background." },
    "print-paper": { "$value": "#ffffff", "$description": "Print: white paper." },
    "print-ink": { "$value": "#000000", "$description": "Print: black text." },

    "surface": { "$value": "{color.paper}", "$description": "Default page surface." },
    "surface-sunken": { "$value": "{color.paper-deep}", "$description": "Recessed surface for alternating bands and callouts." },
    "surface-raised": { "$value": "{color.doc-paper}", "$description": "Lifted surface: the specimen document." },
    "surface-inverse": { "$value": "{color.ink}", "$description": "Dark sections (stages, contact)." },
    "text-muted": { "$value": "{color.muted}", "$description": "Secondary text on surface. 6.3:1 on paper." },
    "heading": { "$value": "{color.ink}", "$description": "Headings." },
    "accent": { "$value": "{color.brass}", "$description": "Accent on light surfaces. 5.2:1 on paper, text-safe." },
    "accent-on-dark": { "$value": "{color.brass-light}", "$description": "Accent on inverse surfaces. 7:1 on ink." },
    "border": { "$value": "{color.rule}", "$description": "Hairline borders and dividers." },
    "action": { "$value": "{color.ink}", "$description": "Primary action background." },
    "action-hover": { "$value": "{color.ink-soft}", "$description": "Primary action hover background." },
    "on-action": { "$value": "{color.paper}", "$description": "Text on the primary action." },
    "action-inverse": { "$value": "{color.paper}", "$description": "Primary action on inverse surfaces: background." },
    "on-action-inverse": { "$value": "{color.ink}", "$description": "Primary action on inverse surfaces: text." }
  },

  "flowbite": {
    "$description": "Flowbite semantic variables remapped onto the Toza palette. Names are fixed by Flowbite; do not rename.",
    "$type": "color",
    "$extensions": { "com.toza.css": { "prefix": "--color-" } },
    "body": { "$value": "{color.muted}" },
    "neutral-primary": { "$value": "{color.paper}" },
    "neutral-primary-soft": { "$value": "{color.paper}" },
    "brand": { "$value": "{color.ink}" },
    "brand-strong": { "$value": "{color.ink-soft}" },
    "brand-soft": { "$value": "{color.paper-deep}" },
    "default": { "$value": "{color.rule}" },
    "default-medium": { "$value": "{color.rule}" }
  },

  "radius": {
    "$type": "dimension",
    "base": { "$value": "3px", "$description": "Buttons and inputs." },
    "DEFAULT": { "$value": "3px", "$description": "Flowbite --radius; equal to radius.base." },
    "stamp": { "$value": "2px", "$description": "Stamp label on the specimen." },
    "bar": { "$value": "1px", "$description": "Redacted-text bar on the specimen." }
  },

  "type": {
    "$type": "typography",
    "body": {
      "$value": { "fontFamily": "{font.sans}", "fontSize": "1.125rem", "fontWeight": 400, "lineHeight": 1.6 },
      "$description": "Body copy (html/body)."
    },
    "display": {
      "$value": { "fontFamily": "{font.serif}", "fontWeight": 400, "letterSpacing": "-0.015em", "lineHeight": 1.06 },
      "$description": "h1 / .display. Size is set per page (home hero: 2.625rem, 3.75rem from sm, 5rem from lg)."
    },
    "h2": {
      "$value": { "fontFamily": "{font.serif}", "fontSize": "clamp(1.875rem, 1.4rem + 1.8vw, 2.75rem)", "fontWeight": 400, "letterSpacing": "-0.01em", "lineHeight": 1.12 },
      "$description": "Section heading (.h2). Fluid size: CSS clamp(), not expressible as a DTCG dimension."
    },
    "numeral": {
      "$value": { "fontFamily": "{font.serif}", "fontWeight": 400, "letterSpacing": "-0.02em", "lineHeight": 1 },
      "$description": "Prices (.numeral). Also font-feature-settings: \"lnum\", \"tnum\" (lining, tabular figures).",
      "$extensions": { "com.toza.css": { "fontFeatureSettings": "\"lnum\", \"tnum\"" } }
    }
  },

  "layout": {
    "$type": "dimension",
    "max-width": { "$value": "76rem", "$description": "Content width (.wrap)." },
    "gutter": { "$value": "1rem", "$description": "Side gutter below sm (640px)." },
    "gutter-wide": { "$value": "2rem", "$description": "Side gutter from sm (640px)." },
    "section-padding": { "$value": "2.75rem", "$description": "Section vertical padding below lg (1024px)." },
    "section-padding-wide": { "$value": "7rem", "$description": "Section vertical padding from lg (1024px)." }
  },

  "focus": {
    "width": { "$type": "dimension", "$value": "3px", "$description": "Focus outline width (:focus-visible)." },
    "offset": { "$type": "dimension", "$value": "3px", "$description": "Focus outline offset." },
    "color": { "$type": "color", "$value": "{color.brass}", "$description": "Focus outline on light surfaces." },
    "color-on-dark": { "$type": "color", "$value": "{color.brass-light}", "$description": "Focus outline on inverse surfaces (.on-ink)." }
  },

  "shadow": {
    "$type": "shadow",
    "doc": {
      "$value": [
        { "color": "{color.shadow-edge}", "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0" },
        { "color": "{color.shadow-ambient}", "offsetX": "0", "offsetY": "18px", "blur": "40px", "spread": "-24px" }
      ],
      "$description": "Specimen document (.doc)."
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "$description": "Tailwind defaults, documented here because the CSS media queries use them. Not emitted: redefining --breakpoint-* would change every responsive utility.",
    "$extensions": { "com.toza.css": { "emit": false } },
    "sm": { "$value": "640px", "$description": "Gutter widens; phone to tablet." },
    "md": { "$value": "768px", "$description": "Stage columns, price strip brackets, price facts as ruled rows." },
    "lg": { "$value": "1024px", "$description": "Full desktop layout, section padding 7rem, sticky navs." }
  }
}
