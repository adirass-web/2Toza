{
  "name": "toza-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Toza v2 — competing rebuild (preview only, noindex).",
  "scripts": {
    "build": "npm run build:css && eleventy",
    "start": "npm run build:css && eleventy --serve",
    "check": "node scripts/check-facts.mjs && node scripts/check-noindex.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:content": "npm run build && node scripts/check-content.mjs",
    "pages:deploy": "wrangler pages deploy",
    "build:css": "tailwindcss -i styles/main.css -o assets/css/main.css --minify"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "flowbite": "^4.0.2",
    "htmlparser2": "7.2.0",
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
