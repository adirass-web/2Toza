{
  "name": "toza-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Toza v2 — competing rebuild (preview only, noindex).",
  "scripts": {
    "build": "node scripts/build-css.mjs && eleventy",
    "start": "npm run build && eleventy --serve",
    "check": "node scripts/check-facts.mjs && node scripts/check-noindex.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "pages:deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@fontsource/heebo": "^5.3.0",
    "@picocss/pico": "^2.1.1",
    "lightningcss": "^1.33.0",
    "open-props": "^1.7.23",
    "sass": "^1.105.1",
    "wrangler": "4.150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
