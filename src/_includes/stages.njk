<section id="how" class="on-ink bg-ink text-paper section" aria-labelledby="stages-h">
  <div class="wrap">
    <h2 id="stages-h" class="h2 !text-paper max-w-2xl">{{ t.stages.heading }}</h2>
    {% if stageLine %}<p class="mt-4 lg:mt-5 max-w-2xl text-lg text-paper/85">{{ stageLine }}</p>{% endif %}
    <ol class="objs mt-8 lg:mt-14 grid gap-7 md:grid-cols-3 md:gap-0">
      <li class="stage md:pe-10 md:border-e md:border-paper/20">
        <div class="obj" dir="ltr">
          <svg viewBox="0 0 160 90" fill="none" stroke="#f7f2e8" stroke-linejoin="round" stroke-linecap="round" role="img" aria-label="{{ t.stages.alt.assess }}">
            <rect x="6" y="10" width="76" height="52" rx="2.5"/>
            <path d="M2 66h84l-4 6H6z"/>
            <path d="M14 20h26M14 28h44M14 36h34" stroke="#cfae6a"/>
            <rect x="92" y="28" width="20" height="46" rx="4"/><path d="M98 33h8"/>
            <rect x="120" y="22" width="34" height="52" rx="1.5"/><path d="M126 32h22M126 40h22M126 48h14" stroke="#cfae6a"/><path d="M126 58h22"/>
            <path d="M0 80h160" stroke-opacity=".35"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif text-2xl lg:text-3xl !text-paper">{{ t.stages.assess.name }}</h3>
          <p class="mt-1.5 lg:mt-3 text-paper/85 max-w-xs">{{ t.stages.assess.line }}</p>
        </div>
      </li>
      <li class="stage md:px-10 md:border-e md:border-paper/20">
        <div class="obj" dir="ltr">
          <svg viewBox="0 0 160 90" fill="none" stroke="#f7f2e8" stroke-linejoin="round" stroke-linecap="round" role="img" aria-label="{{ t.stages.alt.harden }}">
            <g transform="translate(14 0)">
              <rect x="0" y="8" width="84" height="28" rx="14"/><circle cx="16" cy="22" r="6"/><circle cx="62" cy="22" r="5" stroke="#cfae6a"/>
              <path d="M84 15h36v14H84"/><path d="M92 20h18M92 24h18" stroke="#cfae6a"/>
              <rect x="0" y="50" width="84" height="28" rx="14"/><circle cx="16" cy="64" r="6"/><circle cx="62" cy="64" r="5" stroke="#cfae6a"/>
              <path d="M84 57h36v14H84"/><path d="M92 62h18M92 66h18" stroke="#cfae6a"/>
            </g>
          </svg>
        </div>
        <div>
          <h3 class="font-serif text-2xl lg:text-3xl !text-paper">{{ t.stages.harden.name }}</h3>
          <p class="mt-1.5 lg:mt-3 text-paper/85 max-w-xs">{{ t.stages.harden.line }}</p>
        </div>
      </li>
      <li class="stage md:ps-10">
        <div class="obj obj-record" dir="ltr">
          <svg viewBox="0 0 160 90" fill="none" stroke="#f7f2e8" stroke-linejoin="round" stroke-linecap="round" role="img" aria-label="{{ t.stages.alt.verify }}">
            <rect x="14" y="4" width="68" height="82" rx="2"/>
            <path d="M23 4v82"/>
            <rect x="34" y="22" width="40" height="26" rx="1" stroke="#cfae6a"/>
            <path d="M40 31h28M40 39h18" stroke="#cfae6a"/>
            <path d="M34 64h26"/>
            <path d="M66 86V70l5 4 5-4v16"/>
            <path d="M74 35h14" stroke="#cfae6a" stroke-dasharray="2 3"/>
          </svg>
          <p class="obj-date" aria-hidden="true"><span class="font-semibold">{{ t.stages.recordDate[0] }}</span><span>{{ t.stages.recordDate[1] }}</span></p>
        </div>
        <div>
          <h3 class="font-serif text-2xl lg:text-3xl !text-paper">{{ t.stages.verify.name }}</h3>
          <p class="mt-1.5 lg:mt-3 text-paper/85 max-w-xs">{{ t.stages.verify.line }}</p>
        </div>
      </li>
    </ol>
    <p class="mt-9 lg:mt-14 max-w-2xl text-paper/85">{{ t.stages.caption | fill({ price: (facts.prices.assessment | ils) }) }}</p>
    <p class="mt-3 max-w-2xl text-paper/85">{{ t.stages.method }}</p>
    <p class="mt-4"><a class="link" href="#">{{ t.stages.link }}</a></p>
  </div>
</section>
