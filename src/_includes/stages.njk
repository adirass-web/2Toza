<section id="how" class="on-ink bg-ink text-paper section" aria-labelledby="stages-h">
  <div class="wrap">
    <h2 id="stages-h" class="h2 !text-paper max-w-2xl">Three stages, one person.</h2>
    {% if stageLine %}<p class="mt-5 max-w-2xl text-lg text-paper/85">{{ stageLine }}</p>{% endif %}
    <ol class="objs mt-14 grid gap-12 md:grid-cols-3 md:gap-0">
      <li class="md:pe-10 md:border-e md:border-paper/20">
        <svg viewBox="0 0 240 150" fill="none" stroke="#f7f2e8" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" role="img" aria-label="A laptop, a phone and a one-page summary on a table">
          <rect x="14" y="30" width="116" height="76" rx="3"/>
          <path d="M6 112h132l-6 8H12z"/>
          <path d="M26 44h46M26 54h70M26 64h58" stroke="#cfae6a"/>
          <rect x="146" y="48" width="32" height="68" rx="6"/><path d="M156 54h12"/>
          <rect x="188" y="42" width="40" height="78" rx="1.5"/><path d="M196 54h24M196 64h24M196 74h16" stroke="#cfae6a"/><path d="M196 92h24M196 102h18"/>
          <path d="M0 128h240" stroke-opacity=".35"/>
        </svg>
        <h3 class="mt-8 font-serif text-3xl !text-paper">Assess</h3>
        <p class="mt-3 text-paper/85 max-w-xs">Your threat model, your risks in order, and urgent first aid. Typically four hours.</p>
      </li>
      <li class="md:px-10 md:border-e md:border-paper/20">
        <svg viewBox="0 0 240 150" fill="none" stroke="#f7f2e8" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" role="img" aria-label="Two hardware security keys">
          <g><rect x="22" y="28" width="118" height="38" rx="19"/><circle cx="46" cy="47" r="8"/><circle cx="104" cy="47" r="7" stroke="#cfae6a"/>
          <path d="M140 38h46v18h-46"/><path d="M152 44h24M152 50h24" stroke="#cfae6a"/></g>
          <g><rect x="22" y="84" width="118" height="38" rx="19"/><circle cx="46" cy="103" r="8"/><circle cx="104" cy="103" r="7" stroke="#cfae6a"/>
          <path d="M140 94h46v18h-46"/><path d="M152 100h24M152 106h24" stroke="#cfae6a"/></g>
        </svg>
        <h3 class="mt-8 font-serif text-3xl !text-paper">Harden</h3>
        <p class="mt-3 text-paper/85 max-w-xs">Settings, accounts and recovery rebuilt around your risks. Two security keys supplied and configured.</p>
      </li>
      <li class="md:ps-10">
        <svg viewBox="0 0 240 150" fill="none" stroke="#f7f2e8" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" role="img" aria-label="A closed record folder with a dated label">
          <rect x="64" y="14" width="112" height="124" rx="2"/>
          <path d="M78 14v124"/>
          <rect x="94" y="44" width="62" height="40" rx="1" stroke="#cfae6a"/>
          <path d="M102 58h46M102 68h30" stroke="#cfae6a"/>
          <path d="M148 138v-26l8 6 8-6v26" />
          <text x="94" y="106" fill="#f7f2e8" stroke="none" font-family="Frank Ruhl Libre, serif" font-size="13">Dated record</text>
        </svg>
        <h3 class="mt-8 font-serif text-3xl !text-paper">Verify</h3>
        <p class="mt-3 text-paper/85 max-w-xs">Changes tested and checked, and you are taught to use them. A private dated record of the work.</p>
      </li>
    </ol>
    <p class="mt-14 max-w-2xl text-paper/85">Assess is the {{ facts.prices.assessment | ils }} first visit. Harden and Verify are Personal Shield.</p>
    <p class="mt-3 max-w-2xl text-paper/85">Hardening is Toza's own method, developed from public guidance of government security agencies and security vendors.</p>
    <p class="mt-6"><a class="link" href="#">How it works</a></p>
  </div>
</section>
