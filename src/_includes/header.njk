{% from "logos.njk" import logoBtn %}
{#- Flowbite "Navbar with CTA button" (data-collapse-toggle, Flowbite JS collapse). Links and labels come from i18n. -#}
{% set navItems = [
  { href: "/en/#situations", label: t.nav.situations },
  { href: "/en/how-it-works/", label: t.nav.how },
  { href: "/en/pricing/", label: t.nav.pricing },
  { href: "/en/faq/", label: t.nav.faq }
] %}
<header class="print:hidden font-sans sticky top-0 z-40 border-b border-default bg-neutral-primary/95 backdrop-blur">
  <nav aria-label="{{ t.ui.mainNav }}" class="mx-auto flex w-full max-w-wrap flex-wrap items-center justify-between px-gutter py-2 sm:px-gutter-wide md:flex-nowrap lg:py-3">
    <a href="/en/" class="flex shrink-0 items-center" aria-label="{{ t.ui.homeLabel }}">
      <span class="block h-9 text-heading lg:h-10">{% include "wordmark.njk" %}</span>
    </a>
    <div class="inline-flex items-center gap-1 md:order-2 md:gap-3">
      {{ logoBtn("whatsapp", t.buttons.whatsapp, contact.whatsapp.url, "max-md:hidden") }}
      {{ logoBtn("signal", t.buttons.signal, contact.signal.url, "max-md:hidden") }}
      <button type="button" data-theme-toggle hidden aria-pressed="false" aria-label="{{ t.ui.themeToggle }}" class="inline-flex size-11 items-center justify-center text-heading">
        <span aria-hidden="true" class="size-[1.125rem] rounded-full border-[1.5px] border-current bg-linear-to-r from-current from-50% to-transparent to-50%"></span>
      </button>
      <button data-collapse-toggle="navbar-main" type="button" class="inline-flex size-11 items-center justify-center rounded-base text-body hover:bg-neutral-secondary-soft hover:text-heading md:hidden" aria-controls="navbar-main" aria-expanded="false">
        <span class="sr-only">{{ t.ui.menuButton }}</span>
        <svg class="size-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h14"/></svg>
      </button>
    </div>
    <div class="hidden w-full items-center md:order-1 md:flex md:w-auto" id="navbar-main">
      <ul class="mt-2 flex w-full flex-col rounded-base border border-default bg-neutral-secondary-soft p-2 font-medium md:mt-0 md:w-auto md:flex-row md:gap-9 md:border-0 md:bg-transparent md:p-0">
        {% for item in navItems %}
        <li><a href="{{ item.href }}" class="flex min-h-11 items-center rounded-base px-3 text-heading hover:bg-neutral-tertiary md:px-0 md:underline md:decoration-transparent md:decoration-1 md:underline-offset-8 md:hover:bg-transparent md:hover:decoration-accent"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>
