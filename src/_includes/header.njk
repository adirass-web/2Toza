<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 backdrop-blur">
  <div class="navbar wrap min-h-16 lg:min-h-20">
    <div class="navbar-start">
      <a href="/en/" class="inline-flex min-h-11 items-center" aria-label="{{ t.ui.homeLabel }}">
        <img src="/assets/brand/toza-logo-ink.svg" alt="" width="421" height="154" class="h-11 w-auto lg:h-12">
      </a>
    </div>
    <nav class="navbar-center hidden lg:flex" aria-label="{{ t.ui.mainNav }}">
      <ul class="menu menu-lg menu-horizontal gap-2">
        <li><a class="min-h-11 items-center" href="/en/#situations">{{ t.nav.situations }}</a></li>
        <li><a class="min-h-11 items-center" href="/en/how-it-works/">{{ t.nav.how }}</a></li>
        <li><a class="min-h-11 items-center" href="/en/pricing/">{{ t.nav.pricing }}</a></li>
        <li><a class="min-h-11 items-center" href="/en/faq/">{{ t.nav.faq }}</a></li>
      </ul>
    </nav>
    <div class="navbar-end gap-1 sm:gap-3">
      <a class="btn btn-ghost px-2 font-semibold text-primary lg:hidden" href="/en/pricing/">{{ t.nav.pricing }}</a>
      <a class="btn btn-primary px-4 sm:px-5" href="{{ contact.whatsapp.url }}" target="_blank" rel="noopener">{{ t.nav.message }}</a>
      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn btn-ghost btn-square text-primary" aria-label="{{ t.ui.menuButton }}">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h16M3 15h16"/></svg>
        </summary>
        <nav class="dropdown-content z-50 mt-2 w-56 border border-base-300 bg-base-100" aria-label="{{ t.ui.menuNav }}">
          <ul class="menu menu-lg w-full">
            <li><a class="min-h-12 items-center" href="/en/#situations">{{ t.nav.situations }}</a></li>
            <li><a class="min-h-12 items-center" href="/en/how-it-works/">{{ t.nav.how }}</a></li>
            <li><a class="min-h-12 items-center" href="/en/pricing/">{{ t.nav.pricing }}</a></li>
            <li><a class="min-h-12 items-center" href="/en/faq/">{{ t.nav.faq }}</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
