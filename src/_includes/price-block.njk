<section class="section" aria-label="{{ t.ui.pricesLabel }}">
  <div class="wrap">
    <div class="grid gap-7 md:grid-cols-2 md:gap-0">
      <div class="md:pe-14 md:border-e md:border-rule">
        <p class="step-tag">{{ t.price.startHere }}</p>
        <h3 class="mt-3 font-serif text-2xl">{{ t.price.assessment.name }}</h3>
        <p class="mt-4 lg:mt-6"><span class="numeral text-5xl sm:text-6xl lg:text-7xl text-ink">{{ facts.prices.assessment | ils }}</span></p>
        <ul class="facts mt-4 lg:mt-7 border-y border-rule">
          {% for i in t.price.assessment.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
      </div>
      <div class="md:ps-14 md:pt-[2.15rem]">
        <h3 class="font-serif text-2xl">{{ t.price.shield.name }}</h3>
        <p class="mt-4 lg:mt-6"><span class="numeral text-5xl sm:text-6xl lg:text-7xl text-ink">{{ facts.prices.personalShield | ils }}</span></p>
        <ul class="facts mt-4 lg:mt-7 border-y border-rule">
          {% for i in t.price.shield.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
      </div>
    </div>
    <p class="mt-8 lg:mt-10 max-w-2xl text-muted">{{ t.price.credit | fill({ days: facts.credit.windowDays }) }}</p>
    <p class="mt-3 flex flex-wrap gap-x-8"><a class="link font-semibold" href="#">{{ t.price.conditions }} <span class="flip" aria-hidden="true">{{ t.ui.arrow }}</span></a><a class="link text-muted" href="/en/pricing/">{{ t.price.allTiers }} <span class="flip" aria-hidden="true">{{ t.ui.arrow }}</span></a></p>
  </div>
</section>
