<section class="section" aria-labelledby="price-h">
  <div class="wrap">
    <h2 id="price-h" class="h2 max-w-2xl">{{ t.price.heading }}</h2>
    <div class="mt-9 lg:mt-12 grid gap-9 md:grid-cols-2 md:gap-0">
      <div class="md:pe-14 md:border-e md:border-rule">
        <h3 class="font-serif text-2xl">{{ t.price.assessment.name }}</h3>
        <p class="mt-4 lg:mt-6 flex items-baseline gap-3"><span class="numeral text-6xl lg:text-7xl text-ink">{{ facts.prices.assessment | ils }}</span><span class="text-muted">{{ t.price.including }}</span></p>
        <ul class="facts mt-4 lg:mt-7 border-y border-rule">
          {% for i in t.price.assessment.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
      </div>
      <div class="md:ps-14">
        <h3 class="font-serif text-2xl">{{ t.price.shield.name }}</h3>
        <p class="mt-4 lg:mt-6 flex items-baseline gap-3"><span class="numeral text-6xl lg:text-7xl text-ink">{{ facts.prices.personalShield | ils }}</span><span class="text-muted">{{ t.price.including }}</span></p>
        <ul class="facts mt-4 lg:mt-7 border-y border-rule">
          {% for i in t.price.shield.items %}<li>{{ i }}</li>{% endfor %}
        </ul>
      </div>
    </div>
    <p class="mt-8 lg:mt-10 max-w-2xl text-muted">{{ t.price.credit | fill({ days: facts.credit.windowDays }) }}</p>
    <p class="mt-3"><a class="link font-semibold" href="#">{{ t.price.conditions }} <span class="flip" aria-hidden="true">{{ t.ui.arrow }}</span></a></p>
  </div>
</section>
