{% from "logos.njk" import logoBtn %}
{#- Footer (Study G): link list, giant outlined wordmark (decorative, cropped at the bottom edge). Links and labels come from i18n. Photo and icon credits live on About (owner decision, P2). -#}
{% set footItems = [
  { href: "/en/pricing/", label: t.footer.pricing },
  { href: "/en/faq/", label: t.footer.faq },
  { href: "/en/attorneys/", label: t.footer.attorneys },
  { href: "/en/conditions/", label: t.footer.conditions },
  { href: "/en/about/", label: t.footer.about }
] %}
<footer class="print:hidden relative overflow-hidden border-t border-default bg-neutral-primary-soft font-sans max-md:pb-bar">
  <div class="w-full px-edge pt-8">
    <nav aria-label="{{ t.ui.footerNav }}">
      <ul class="flex flex-wrap gap-x-7 gap-y-1 text-body">
        {% for item in footItems %}
        <li><a href="{{ item.href }}" class="inline-flex min-h-11 items-center underline decoration-rule decoration-1 underline-offset-8 hover:decoration-heading">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="my-10 w-full text-heading" aria-hidden="true" data-copy-exempt>
      {% set wmCls = "block h-auto w-full" %}{% include "wordmark.njk" %}{% set wmCls = "" %}
    </div>
  </div>
</footer>
<nav class="print:hidden fixed inset-x-0 bottom-0 z-40 flex h-bar items-center justify-center gap-5 border-t border-default bg-neutral-primary pb-[env(safe-area-inset-bottom)] md:hidden" aria-label="{{ t.ui.messageBar }}">
  {{ logoBtn("whatsapp", t.buttons.whatsapp, contact.whatsapp.url, "") }}
  {{ logoBtn("signal", t.buttons.signal, contact.signal.url, "") }}
</nav>
