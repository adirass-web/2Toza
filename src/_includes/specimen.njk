<h3 class="font-serif text-2xl lg:text-3xl leading-snug text-ink mb-4 lg:mb-7">{{ t.specimen.heading }}</h3>
<figure>
  <div class="doc p-5 sm:p-8 text-base leading-snug text-text">
    <div class="flex items-center justify-between gap-4 pb-3 border-b-2 border-ink">
      <img src="/assets/brand/toza-logo-ink.svg" alt="" width="88" height="32" class="h-8 w-auto">
      <p class="stamp">{{ t.specimen.confidential }}</p>
    </div>
    <div class="mt-5">
      <p class="font-serif text-3xl sm:text-4xl text-ink leading-none">{{ t.specimen.title }}</p>
      <p class="mt-2 text-muted">{{ t.specimen.subtitle }}</p>
      <p class="mt-1 text-brass font-semibold">{{ t.stages.recordDate | join(" ") }}</p>
    </div>
    <dl class="mt-4 pt-3 border-t border-rule space-y-3">
      <div><dt class="font-semibold text-ink">{{ t.specimen.circumstances }}</dt><dd class="mt-1.5"><span class="bar w-4/5"></span></dd></div>
      <div><dt class="font-semibold text-ink">{{ t.specimen.reviewed }}</dt><dd class="mt-0.5">{{ t.specimen.reviewedText }}</dd></div>
      <div><dt class="font-semibold text-ink">{{ t.specimen.found }}</dt>
        <dd class="mt-0.5"><ul class="entries">{% for i in t.specimen.foundItems %}<li>{{ i }}</li>{% endfor %}</ul></dd></div>
      <div><dt class="font-semibold text-ink">{{ t.specimen.remaining }}</dt><dd class="mt-0.5">{{ t.specimen.remainingText }}</dd></div>
      <div><dt class="font-semibold text-ink">{{ t.specimen.next }}</dt>
        <dd class="mt-0.5"><ol class="list-decimal ps-5 marker:text-brass marker:font-semibold">{% for i in t.specimen.nextItems %}<li>{{ i }}</li>{% endfor %}</ol></dd></div>
    </dl>
  </div>
  <figcaption class="mt-4 text-muted text-base">{{ t.specimen.label }}</figcaption>
</figure>
