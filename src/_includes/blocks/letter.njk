{#- A personal note: Flowbite typography blockquote-free serif passage, signature over a brass hairline. -#}
{% from "blocks/_macros.njk" import section, h2 with context %}
{% call section(block, 'sunken', 'grid gap-8 lg:grid-cols-12 lg:gap-16') %}
  <div class="lg:col-span-4">{{ h2(block.heading) }}</div>
  <div class="lg:col-span-7 lg:col-start-6">
    <div class="space-y-5 font-serif text-xl leading-relaxed text-heading lg:text-2xl">{{ block.body.html | safe }}</div>
    <p class="mt-5 w-fit border-t border-accent pt-3 pe-10 font-serif text-2xl text-heading italic">{{ block.signature }}</p>
  </div>
{% endcall %}
