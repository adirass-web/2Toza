{#- The three stages in detail: a Flowbite stepper timeline on ink, one hairline row per stage (drawing, name and result, explanation and what you keep). The drawings are the shared SVG partials. -#}
{% from "blocks/_macros.njk" import section, h2 with context %}
{% call section(block, 'dark', '') %}
  {{ h2(block.heading, 'text-paper') }}
  {% if block.lead %}<p class="mt-3 text-lg text-on-dark-text">{{ block.lead }}</p>{% endif %}
  <ol class="mt-8 border-b border-on-dark-rule lg:mt-14">
    {% for step in block.items %}
    <li class="grid grid-cols-12 gap-x-0 gap-y-4 lg:gap-x-10 border-t border-on-dark-rule py-7 lg:gap-y-3 lg:py-12">
      <div class="relative col-span-4 self-center me-5 lg:me-0 lg:col-span-3 lg:row-span-2 lg:max-w-56 lg:self-start" dir="ltr">
        {% set alt = step.image_alt %}{% include "drawing-" + step.key + ".njk" %}
        {% if step.key == 'verify' and block.record_date %}<p class="absolute inset-e-0 inset-bs-1/6 w-1/4 text-end font-serif text-sm leading-tight text-accent-on-dark md:text-lg" aria-hidden="true">{{ block.record_date }}</p>{% endif %}
      </div>
      <p class="col-span-8 self-center font-serif text-2xl text-accent-on-dark lg:col-span-4 lg:col-start-4 lg:self-start lg:text-3xl">{{ loop.index }} · {{ step.name }}</p>
      <h3 class="col-span-12 font-serif text-2xl leading-snug font-normal text-paper lg:col-span-4 lg:col-start-4 lg:text-3xl">{{ step.heading }}</h3>
      <div class="col-span-12 max-w-2xl space-y-4 text-on-dark-text lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1">
        {% if step.statement %}<p class="font-serif text-xl text-paper">{{ step.statement }}</p>{% endif %}
        <div class="space-y-4">{{ step.body.html | safe }}</div>
        {% if step.keep %}<p class="border-t border-on-dark-rule pt-3">{% if block.keep_label %}<span class="block font-semibold text-accent-on-dark">{{ block.keep_label }}</span>{% endif %}{{ step.keep }}</p>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
{% endcall %}
