{#- Option C (review): the method as state changes. Recessed paper section, laid out as a ledger.
    From lg one grid carries every row (CSS subgrid): area · before · three stage columns · after. Each row's stage
    columns hold a track: an ink line running from "before" to "after", ending in an arrow, with a filled node where a
    stage works on that part and a ring where it does not. The stage names and lines head the stage columns.
    Below lg each part stacks: area, before, the track (stage names under the nodes), after; the stage header keeps
    the same three columns, so the nodes line up with it.
    Accessibility: the parts are a list with h3 headings; "before"/"after" labels are real text in every row (visually
    hidden from lg, where the column heads, aria-hidden, show them once); the stages that work on a part are a
    visually hidden list. The track is aria-hidden. -#}
{% from "blocks/_macros.njk" import section with context %}
{% set ledger = 'lg:grid-cols-[var(--spacing-area)_minmax(0,1fr)_repeat(3,var(--spacing-track))_minmax(0,1fr)] xl:grid-cols-[var(--spacing-area)_minmax(0,1fr)_repeat(3,var(--spacing-track-wide))_minmax(0,1fr)]' %}
{% call section(block, 'sunken', '') %}
  <div class="max-w-3xl">
    <h2 class="font-serif text-h2 leading-h2 font-normal tracking-h2 text-balance text-heading">{{ block.heading }}</h2>
    {% if block.lead %}<p class="mt-3 text-lg text-body">{{ block.lead }}</p>{% endif %}
  </div>
  <div class="mt-10 lg:mt-14 lg:grid lg:gap-x-8 {{ ledger }}">
    <div class="border-b border-dark pb-4 lg:col-span-6 lg:grid lg:grid-cols-subgrid lg:items-end">
      <p aria-hidden="true" class="hidden text-base text-body-subtle lg:col-start-2 lg:block">{{ block.before_label }}</p>
      <ol role="list" class="grid grid-cols-3 lg:col-span-3 lg:col-start-3">
        {% for s in block.stages %}
        <li class="px-1 text-center">
          <h3 class="font-serif text-xl leading-tight font-normal text-heading lg:text-2xl">{{ s.name }}</h3>
          <p class="mt-1 text-sm leading-snug text-body-subtle">{{ s.line }}</p>
        </li>
        {% endfor %}
      </ol>
      <p aria-hidden="true" class="hidden text-base text-body-subtle lg:col-start-6 lg:block">{{ block.after_label }}</p>
    </div>
    <ul role="list" class="lg:col-span-6 lg:grid lg:grid-cols-subgrid">
      {% for r in block.rows %}
      <li class="border-b border-default py-6 lg:col-span-6 lg:grid lg:grid-cols-subgrid lg:items-center lg:py-5">
        <h3 class="font-serif text-2xl leading-tight font-normal text-heading">{{ r.area }}</h3>
        <div class="mt-3 lg:mt-0">
          <p class="text-sm text-body-subtle lg:sr-only">{{ block.before_label }}</p>
          <p class="text-base text-body-subtle">{{ r.before }}</p>
        </div>
        <div class="my-5 lg:col-span-3 lg:my-0">
          <p class="sr-only">{{ block.marks_label }}</p>
          <ul role="list" class="sr-only">{% for s in block.stages %}{% if s.key in r.stages %}<li>{{ s.name }}</li>{% endif %}{% endfor %}</ul>
          <div aria-hidden="true" class="relative grid grid-cols-3">
            {#- progress: dashed and muted until the first stage that works on the part, solid ink from there to the arrow -#}
            {% set firstOn = -1 %}{% for s in block.stages %}{% if firstOn == -1 and s.key in r.stages %}{% set firstOn = loop.index0 %}{% endif %}{% endfor %}
            <span class="absolute inset-x-0 top-[calc(var(--spacing-node)/2_-_0.5px)] border-t border-dashed border-body-subtle"></span>
            <span class="absolute inset-e-0 top-[calc(var(--spacing-node)/2_-_0.5px)] h-px bg-dark {{ ['inset-s-[16.6667%]', 'inset-s-1/2', 'inset-s-[83.3333%]'][firstOn] }}"></span>
            <span class="absolute inset-e-0 top-[calc(var(--spacing-node)/2_-_0.3125rem)] size-2.5 rotate-45 border-t border-e border-dark rtl:-rotate-45"></span>
            {% for s in block.stages %}
            <span class="relative flex flex-col items-center gap-1.5">
              <span class="size-node rounded-full {{ 'bg-dark' if s.key in r.stages else 'border-2 border-body-subtle bg-neutral-secondary-soft' }}"></span>
              <span class="text-sm text-body-subtle lg:hidden">{{ s.name }}</span>
            </span>
            {% endfor %}
          </div>
        </div>
        <div>
          <p class="text-sm text-body-subtle lg:sr-only">{{ block.after_label }}</p>
          <p class="text-base text-heading">{{ r.after }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% if block.marks_key %}
  <p class="mt-5 flex items-center gap-2.5 text-sm text-body-subtle"><span aria-hidden="true" class="flex items-center gap-1.5"><span class="size-node rounded-full bg-dark"></span><span class="size-node rounded-full border-2 border-body-subtle"></span></span>{{ block.marks_key }}</p>
  {% endif %}
  {% if block.coda %}<p class="mt-10 max-w-3xl border-s-3 border-accent ps-4 font-serif text-xl leading-snug text-heading lg:text-2xl">{{ block.coda }}</p>{% endif %}
{% endcall %}
