{% from "blocks/_macros.njk" import link, price with context %}
<section{% if block.id %} id="{{ block.id }}"{% endif %} class="section">
  <div class="wrap">
    <h2 class="{{ 'mb-6 font-serif font-normal text-primary text-balance text-(length:--type-h2-font-size) leading-(--type-h2-line-height) tracking-(--type-h2-letter-spacing)' if block.heading_visible else 'sr-only' }}">{{ block.heading }}</h2>
    {% if block.statement %}<p class="max-w-3xl font-serif text-xl leading-snug text-primary lg:text-2xl">{{ block.statement }}</p>{% endif %}
    {% if block.first_step %}<div class="mt-8 lg:mt-12">{% set outer = block %}{% set block = outer.first_step %}{% include "blocks/offer.njk" %}{% set block = outer %}</div>{% endif %}
    <ul class="mt-10 grid gap-6 lg:mt-14 lg:grid-cols-3">
      {% for tier in block.tiers %}
      <li class="card card-border border-t-2 border-t-accent bg-base-100 lg:row-span-4 lg:grid lg:grid-rows-subgrid lg:gap-y-0">
        <h3 class="card-title px-6 pt-7 font-serif text-2xl font-normal text-primary lg:px-8 lg:pt-10 lg:text-3xl">{{ tier.name }}</h3>
        <p class="px-6 pt-5 lg:px-8 lg:pt-7">{{ price(tier, "font-serif text-5xl leading-none tracking-tight text-primary lining-nums tabular-nums sm:text-6xl lg:text-5xl xl:text-6xl") }}</p>
        <p class="px-6 pt-4 text-lg lg:px-8 lg:pt-5">{{ tier.for }}</p>
        {% if tier.items %}
        <ul class="list mx-6 mt-5 mb-7 border-y border-base-300 text-base lg:mx-8 lg:mt-8 lg:mb-10">
          {% for i in tier.items %}<li class="list-row px-0 py-3 after:border-base-300">{{ i }}</li>{% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% if block.notes %}<div class="mt-8 grid max-w-3xl gap-3 text-muted">{% for note in block.notes %}<div class="md">{{ note.html | safe }}</div>{% endfor %}</div>{% endif %}
    {% if block.link %}<p class="mt-4">{{ link(block.link) }}</p>{% endif %}
  </div>
</section>
