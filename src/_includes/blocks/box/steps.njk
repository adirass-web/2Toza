{#- How it works detail: each ordered row confines one native sticky stage card beside its explanation and result. Remaining grid cells stay as ground; rows keep natural height. -#}
<section{% if block.id %} id="{{ block.id }}"{% endif %} class="py-8 lg:py-12">
  <div class="grid grid-cols-4 gap-x-cell gap-y-6 px-edge md:grid-cols-12">
    <div class="col-span-4 md:col-span-6 md:col-start-4">
      <h2 class="font-serif text-h2 leading-h2 font-normal tracking-h2 text-balance text-heading">{{ block.heading }}</h2>
      {% if block.lead %}<p class="mt-3 text-lg text-body-subtle">{{ block.lead }}</p>{% endif %}
    </div>
    <ol class="col-span-4 grid grid-cols-4 gap-cell md:col-span-12 md:grid-cols-12">
      {% for step in block.items %}
      <li data-process-step="{{ step.key }}" class="col-span-4 grid grid-cols-4 items-start gap-cell border-t border-default pt-4 md:col-span-9 md:col-start-1 md:grid-cols-9 md:pt-6">
        <div data-process-card data-tone="dark" class="col-span-4 self-start bg-dark p-4 text-paper md:col-span-3 md:p-5 md:motion-safe:sticky md:motion-safe:[inset-block-start:6rem] print:static">
          <div class="relative max-w-40" dir="ltr">
            {% set alt = step.image_alt %}{% include "drawing-" + step.key + ".njk" %}
            {% if step.key == 'verify' and block.record_date %}<p class="absolute inset-e-0 inset-bs-1/6 w-1/2 text-end font-serif text-sm leading-tight text-accent-on-dark" aria-hidden="true">{{ block.record_date }}</p>{% endif %}
          </div>
          <p class="mt-3 font-serif text-xl text-paper">{{ loop.index }} · {{ step.name }}</p>
        </div>
        <div class="col-span-4 space-y-4 bg-paper-deep p-5 text-heading md:col-span-6 md:col-start-4 md:p-6">
          <h3 class="font-serif text-2xl leading-snug font-normal text-heading lg:text-3xl">{{ step.heading }}</h3>
          {% if step.statement %}<p class="font-serif text-lg leading-snug text-heading lg:text-xl">{{ step.statement }}</p>{% endif %}
          <div class="space-y-4 text-lg leading-snug text-body">{{ step.body.html | safe }}</div>
          {% if step.keep %}<p data-process-keep class="border-t border-default pt-3 text-lg leading-snug text-body">{% if block.keep_label %}<span class="mb-1 block font-sans text-sm font-semibold text-heading">{{ block.keep_label }}</span>{% endif %}{{ step.keep }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
