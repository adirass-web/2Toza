{#- Box layout, text: a single 50% prose box; markdown and its links come from the resolved content. -#}
{% from "blocks/_macros.njk" import h2, links with context %}
<section{% if block.id %} id="{{ block.id }}"{% endif %} class="scroll-mt-24 py-4 lg:py-6">
  <div class="grid grid-cols-4 gap-cell px-edge md:grid-cols-12">
    <div class="col-span-4 bg-paper-deep p-6 text-heading md:col-span-6 md:col-start-4 lg:p-8">
      {{ h2(block.heading) }}
      <div class="mt-4 space-y-4 font-serif text-lg leading-snug lg:mt-6 lg:text-xl">{{ block.body.html | safe }}</div>
      {{ links(block.links, '', 'mt-5') }}
    </div>
  </div>
</section>
