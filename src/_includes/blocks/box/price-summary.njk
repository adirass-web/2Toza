{#- Box layout, prices: a 50% mint box (the first step), a 25% grey box (Personal Shield), a quiet label in the first column. Figures from facts.json. -#}
{% from "blocks/_macros.njk" import price, lnk with context %}
<section id="pricing" class="scroll-mt-24 pb-12 lg:pb-20">
  <div class="grid grid-cols-1 gap-cell px-edge md:grid-cols-4">
    <p class="flex items-start gap-2 font-sans text-xs font-semibold tracking-wide text-body-subtle uppercase md:sticky md:top-24 md:self-start"><span class="mt-[.2em] block size-1.5 shrink-0 bg-mint" aria-hidden="true"></span>{{ t.ui.pricesLabel }}</p>
    {% for item in block.items %}
    <div class="flex min-h-72 flex-col gap-4 p-6 lg:min-h-112 lg:p-8 {{ 'bg-mint text-on-mint md:col-span-2' if loop.first else 'bg-sand text-heading' }}">
      {% if item.tag %}<p class="font-sans text-xs font-semibold tracking-wide uppercase">{{ item.tag }}</p>{% endif %}
      <h3 class="font-serif text-2xl leading-tight lg:text-3xl">{{ item.name }}</h3>
      <p>{{ price(item, 'text-5xl lg:text-7xl') }}</p>
      <p class="mt-auto max-w-xs text-lg">{{ item.note }}</p>
    </div>
    {% endfor %}
  </div>
  {% if block.link %}<p class="mt-8 px-edge">{{ lnk(block.link) }}</p>{% endif %}
</section>
