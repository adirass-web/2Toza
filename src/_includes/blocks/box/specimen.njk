{#- Box layout, specimen: the exposure summary as a white document on a grey box (50%), heading beside it. Square corners, no shadow. -#}
{% from "blocks/_macros.njk" import section, h2 with context %}
{% set doc = block.document %}
<section class="scroll-mt-24 pb-12 lg:pb-20">
  <div class="grid grid-cols-4 gap-x-cell gap-y-8 px-edge md:grid-cols-12 md:items-center">
  <div class="col-span-4 md:col-span-4">{{ h2(block.heading) }}</div>
  <figure class="col-span-4 bg-paper-deep p-5 md:col-span-6 md:col-start-7 lg:p-10">
    <div class="bg-doc-paper p-5 text-base leading-snug text-body sm:p-8">
      <div class="flex items-center justify-between gap-4 border-b-2 border-brand pb-3">
        <span class="block h-8 text-heading">{% include "wordmark.njk" %}</span>
        <p class="rounded-stamp border border-accent px-2 py-0.5 text-sm font-semibold tracking-wide text-accent">{{ doc.stamp }}</p>
      </div>
      <div class="mt-5">
        <h3 class="font-serif text-3xl leading-none font-normal text-heading sm:text-4xl">{{ doc.title }}</h3>
        {% if doc.subtitle %}<p class="mt-2 text-body-subtle">{{ doc.subtitle }}</p>{% endif %}
        {% if doc.date %}<p class="mt-1 font-semibold text-accent">{{ doc.date }}</p>{% endif %}
      </div>
      <dl class="mt-4 space-y-3 border-t border-default pt-3">
        {% for entry in doc.entries %}
        <div>
          <dt class="font-semibold text-heading">{{ entry.label }}</dt>
          <dd class="mt-0.5">
            {% if entry.redacted %}<span class="mt-2 block h-3 w-4/5 rounded-bar bg-neutral-quaternary" aria-hidden="true"></span>{% endif %}
            {% if entry.text %}{{ entry.text }}{% endif %}
            {% if entry.items %}<{{ 'ol' if entry.ordered else 'ul' }} class="ps-5 marker:font-semibold marker:text-accent {{ 'list-decimal' if entry.ordered else 'list-disc' }}">{% for i in entry.items %}<li>{{ i }}</li>{% endfor %}</{{ 'ol' if entry.ordered else 'ul' }}>{% endif %}
          </dd>
        </div>
        {% endfor %}
      </dl>
    </div>
    <figcaption class="mt-4 font-sans text-base text-body-subtle">{{ block.caption }}</figcaption>
  </figure>
  </div>
</section>
