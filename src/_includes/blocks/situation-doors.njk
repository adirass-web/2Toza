<section{% if block.id %} id="{{ block.id }}"{% endif %} class="section bg-base-200">
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-0">
    <h2 class="font-serif font-normal text-primary text-balance text-(length:--type-h2-font-size) leading-(--type-h2-line-height) tracking-(--type-h2-letter-spacing) lg:col-span-4 lg:row-start-1">{{ block.heading }}</h2>
    <ul class="list border-y border-base-300 text-base lg:col-span-8 lg:col-start-5 lg:row-span-2 lg:row-start-1">
      {% for door in block.items %}
      <li class="list-row group items-center px-0 py-5 after:border-base-300">
        <div class="list-col-grow">
          <a class="block font-serif text-2xl text-primary after:absolute after:inset-0 group-hover:underline group-hover:decoration-accent lg:text-3xl" href="{{ door.href }}">{{ door.title }}</a>
          <span class="mt-1 block text-muted">{{ door.line }}</span>
        </div>
        <svg class="text-accent transition-transform group-hover:translate-x-1 rtl:-scale-x-100 rtl:group-hover:-translate-x-1" width="28" height="14" viewBox="0 0 28 14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M0 7h26M20 1l6 6-6 6"/></svg>
      </li>
      {% endfor %}
    </ul>
    {% if block.aside %}<p class="max-w-xs font-serif text-xl italic text-muted lg:col-span-4 lg:row-start-2 lg:mt-6">{{ block.aside }}</p>{% endif %}
  </div>
</section>
