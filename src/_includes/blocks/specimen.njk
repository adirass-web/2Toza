<section{% if block.id %} id="{{ block.id }}"{% endif %} class="section">
  <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-16">
    <h2 class="font-serif font-normal text-primary text-balance text-(length:--type-h2-font-size) leading-(--type-h2-line-height) tracking-(--type-h2-letter-spacing) lg:col-span-5">{{ block.heading }}</h2>
    <figure class="lg:col-span-6 lg:col-start-7">
      <article class="card border border-base-300 bg-surface-raised shadow-(--shadow-doc)">
        <div class="card-body gap-0 p-5 sm:p-8">
          <div class="flex items-center justify-between gap-4 border-b-2 border-primary pb-3">
            <img src="/assets/brand/toza-logo-ink.svg" alt="" width="88" height="32" class="h-8 w-auto">
            <p class="badge badge-outline badge-accent font-semibold">{{ block.document.stamp }}</p>
          </div>
          <div class="mt-5">
            <h3 class="font-serif text-3xl leading-none text-primary sm:text-4xl">{{ block.document.title }}</h3>
            {% if block.document.subtitle %}<p class="mt-2 text-muted">{{ block.document.subtitle }}</p>{% endif %}
            {% if block.document.date %}<p class="mt-1 font-semibold text-accent">{{ block.document.date }}</p>{% endif %}
          </div>
          <dl class="mt-4 grid gap-3 border-t border-base-300 pt-3 text-base leading-snug">
            {% for entry in block.document.entries %}
            <div>
              <dt class="font-semibold text-primary">{{ entry.label }}</dt>
              <dd class="mt-1">
                {% if entry.redacted %}<span class="skeleton block h-3 w-4/5 animate-none" aria-hidden="true"></span>{% endif %}
                {% if entry.text %}{{ entry.text }}{% endif %}
                {% if entry.items %}{% if entry.ordered %}<ol class="list-decimal ps-5 marker:font-semibold marker:text-accent">{% else %}<ul class="list-disc ps-5 marker:text-accent">{% endif %}{% for i in entry.items %}<li>{{ i }}</li>{% endfor %}{% if entry.ordered %}</ol>{% else %}</ul>{% endif %}{% endif %}
              </dd>
            </div>
            {% endfor %}
          </dl>
        </div>
      </article>
      <figcaption class="mt-4 text-base text-muted">{{ block.caption }}</figcaption>
    </figure>
  </div>
</section>
