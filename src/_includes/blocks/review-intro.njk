{#- Review scaffolding (design review pages only, never on a live page): the page h1 and how to read the options. -#}
{% from "blocks/_macros.njk" import section with context %}
{% call section(block, '', '', '', 'pt-10 pb-8 lg:pt-14 lg:pb-10') %}
  <h1 class="font-serif text-4xl leading-display font-normal tracking-display text-balance text-heading lg:text-5xl">{{ block.heading }}</h1>
  {% if block.line %}<p class="mt-3 max-w-2xl text-body-subtle">{{ block.line }}</p>{% endif %}
{% endcall %}
