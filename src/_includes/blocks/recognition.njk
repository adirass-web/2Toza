{#- Flowbite list group (default), one row per signal. -#}
{% from "blocks/_macros.njk" import section, h2, links with context %}
{% call section(block, 'sunken', 'grid gap-10 lg:grid-cols-12 lg:gap-16') %}
  <div class="lg:col-span-5">
    {{ h2(block.heading) }}
    {% if block.lead %}<p class="mt-6 max-w-md text-lg">{{ block.lead }}</p>{% endif %}
    {{ links(block.links, '', 'mt-6') }}
  </div>
  <ul class="divide-y divide-default rounded-base border border-default bg-neutral-primary-soft font-serif text-xl leading-snug text-heading lg:col-span-7 lg:col-start-6 lg:text-2xl">
    {% for item in block.items %}<li class="px-5 py-5 lg:px-8">{{ item }}</li>{% endfor %}
  </ul>
{% endcall %}
