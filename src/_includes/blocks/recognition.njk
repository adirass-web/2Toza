{#- Flowbite list group (default) as hairline rows (Direction A): no box, no background, no radius. -#}
{% from "blocks/_macros.njk" import section, h2, links with context %}
{% call section(block, 'sunken', 'grid gap-10 lg:grid-cols-12 lg:gap-16') %}
  <div class="lg:col-span-5">
    {{ h2(block.heading) }}
    {% if block.lead %}<p class="mt-6 max-w-md text-lg">{{ block.lead }}</p>{% endif %}
    {{ links(block.links, '', 'mt-6') }}
  </div>
  <ul class="border-b border-default font-serif text-xl leading-snug text-heading lg:col-span-7 lg:col-start-6 lg:text-2xl">
    {% for item in block.items %}<li class="min-h-11 border-t border-default py-5">{{ item }}</li>{% endfor %}
  </ul>
{% endcall %}
