{% from "blocks/_macros.njk" import link, links %}
<section{% if block.id %} id="{{ block.id }}"{% endif %}>
  <h2>{{ block.heading }}</h2>
  {% if block.lead %}<p>{{ block.lead }}</p>{% endif %}
  <ul>
    {% for item in block.items %}<li>{{ item }}</li>{% endfor %}
  </ul>
  {{ links(block.links) }}
</section>
