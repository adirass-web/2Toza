{% from "blocks/_macros.njk" import section, h2, actions, lnk with context %}
{% call section(block, 'dark', 'grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-10', '', 'py-8 lg:py-12 print:hidden') %}
  <div class="lg:col-span-5">
    {{ h2(block.heading, 'text-paper') }}
    {% if block.body %}<p class="mt-2 max-w-xl text-lg text-on-dark-text lg:mt-3">{{ block.body }}</p>{% endif %}
  </div>
  <div class="lg:col-span-7">
    {{ actions(block.actions, 'dark', 'grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3', 'col-span-2 sm:col-span-1') }}
    {% if block.note %}<p class="mt-3">{{ lnk(block.note, 'dark') }}</p>{% endif %}
  </div>
{% endcall %}
