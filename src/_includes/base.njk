<!doctype html>
<html lang="{{ t.lang }}" dir="{{ t.dir }}" class="motion-safe:scroll-smooth">
<head>{% include "favicon.njk" %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="{{ tokens.paper }}">
  <link rel="preload" href="/assets/fonts/frank-ruhl-libre-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/assistant-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <script>document.documentElement.classList.add("js")</script>
  <link rel="stylesheet" href="/assets/css/main.css">{% if pg.page == 'faq' or pg.page == 'conditions' %}<link rel="stylesheet" href="/approved-en-assets/css/reference-pages.css">{% endif %}
  <link rel="stylesheet" href="/approved-en-assets/css/shared-shell.css">
  <link rel="stylesheet" href="/approved-en-assets/css/contact-icons.css">
  <script src="/assets/js/site.js" defer></script>
</head>
<body class="has-fixed-contacts legacy-content-page print:bg-print-paper print:text-print-ink bg-neutral-primary font-serif text-lg leading-relaxed text-body{% if pg.page == 'faq' or pg.page == 'conditions' %} reference-reading-page reference-reading-page--{{ pg.page }}{% endif %}">
<a href="#main" class="skip-link">{{ t.ui.skip }}</a>
{% set legacyTranslation = t %}{% set t = approvedEN.copy.en %}
{% include "approved-en/header.njk" %}
{% set t = legacyTranslation %}
<main id="main"><span id="main-content"></span>
{{ content | safe }}
</main>
{% include "approved-en/footer.njk" %}
{% include "approved-en/contact-icons.njk" %}
</body>
</html>
