<section class="on-ink bg-ink text-paper section" aria-labelledby="contact-h">
  <div class="wrap grid gap-8 lg:gap-10 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-5">
      <h2 id="contact-h" class="h2 !text-paper">{{ t.contact.heading }}</h2>
      <p class="mt-5 max-w-xl text-lg text-paper/85">{{ t.contact.reassurance }}</p>
    </div>
    <div class="lg:col-span-7">
      {% include "cta-full.njk" %}
      {% if contactNote %}<p class="mt-5"><a class="link" href="{{ contactHref }}">{{ contactNote }}</a></p>{% endif %}
    </div>
  </div>
</section>
