{% from "approved-en/photo.njk" import photo %}
<!doctype html>
<html lang="{{ locale.lang }}" dir="{{ locale.dir }}">
<head>{% include "favicon.njk" %}
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><meta name="description" content="{{ t.description }}"><title>{{ t.title }}</title>
<link rel="stylesheet" href="/approved-en-assets/css/main.css"><link rel="stylesheet" href="/approved-en-assets/css/en-continuation.css"><link rel="stylesheet" href="/approved-en-assets/css/en-prices.css"><link rel="stylesheet" href="/approved-en-assets/css/contact-icons.css">
<script src="/assets/js/restrained-motion.js" defer></script>
</head>
<body class="has-fixed-contacts">
<a class="skip-link" href="#main">{{ t.skip }}</a>
{% include "approved-en/header.njk" %}
<main id="main"><span id="main-content"></span>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-image">
      {{ photo({src: '/approved-en-assets/photos/hero-wide-1536.webp', srcset: '/approved-en-assets/photos/hero-wide-900.webp 900w, /approved-en-assets/photos/hero-wide-1536.webp 1536w', sizes: '100vw', width: 1536, height: 1024, alt: t.heroAlt, variant: 'hero', priority: 'high', className: 'hero-photo'}) }}
      <figcaption class="hero-title"><h1 id="hero-title">{{ t.hero }}</h1></figcaption>
    </figure>
    <div class="hero-explanation">
      <p class="copy">{{ t.explanation }}</p>
      <p class="copy">{{ t.expert }}</p>
      <p class="service-line">{{ t.service }}</p>
      <h2 class="invitation">{{ t.invitation }}</h2>
      {% include "approved-en/messaging-actions.njk" %}
      <p class="copy">{{ t.reassurance }}</p>
    </div>
  </section>
  <figure class="mx-auto my-8 max-w-5xl px-4 sm:my-12">
    <a class="block" href="/assets/img/toza-digital-exposure-five-ws.png" aria-label="Open the full-size digital exposure illustration">
      {{ photo({src: '/approved-en-assets/photos/digital-exposure-five-ws.webp', srcset: '/approved-en-assets/photos/digital-exposure-five-ws.webp 1635w', sizes: '(max-width: 64rem) calc(100vw - 2rem), 62rem', width: 1635, height: 962, alt: 'A phone diagram connects everyday data to what someone could infer about who you know, what you do, where you go, when things happen and why.', variant: 'situation-hero', priority: 'lazy'}) }}
    </a>
  </figure>
  {% include "approved-en/en-situations-cta.njk" %}{% include "approved-en/en-prices.njk" %}
</main>
{% include "approved-en/footer.njk" %}
{% include "approved-en/contact-icons.njk" %}
</body>
</html>
