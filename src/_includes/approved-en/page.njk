<!doctype html>
<html lang="{{ locale.lang }}" dir="{{ locale.dir }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><meta name="description" content="{{ t.description }}"><title>{{ t.title }}</title>
<link rel="stylesheet" href="/approved-en-assets/css/main.css"><link rel="stylesheet" href="/approved-en-assets/css/en-continuation.css"><link rel="stylesheet" href="/approved-en-assets/css/en-prices.css"><link rel="stylesheet" href="/approved-en-assets/css/contact-icons.css">
</head>
<body class="has-fixed-contacts">
<a class="skip-link" href="#main">{{ t.skip }}</a>
{% include "approved-en/header.njk" %}
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-image">
      <img class="hero-photo" src="/approved-en-assets/photos/hero-wide.png" alt="{{ t.heroAlt }}" fetchpriority="high">
      <figcaption class="hero-title"><h1 id="hero-title">{{ t.hero }}</h1></figcaption>
    </figure>
    <div class="hero-explanation">
      <p class="copy">{{ t.explanation }}</p>
      <p class="service-line">{{ t.service }}</p>
      <p class="invitation">{{ t.invitation }}</p>
    </div>
  </section>
  {% include "approved-en/en-situations-cta.njk" %}{% include "approved-en/en-prices.njk" %}
</main>
<footer class="mx-auto max-w-7xl px-5 py-8 font-sans text-sm text-[#62645e]">{{ t.footer }}</footer>
{% include "approved-en/contact-icons.njk" %}
</body>
</html>
