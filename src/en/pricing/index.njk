---
layout: base.njk
title: Pricing — Toza
description: Toza's fees. One first step, then the protection that fits your household.
permalink: /en/pricing/index.html
---
<section class="pt-8 pb-10 lg:pt-20 lg:pb-16" aria-labelledby="h1">
  <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h1 id="h1" class="display text-[2.625rem] sm:text-6xl lg:text-[5rem] !text-ink">{{ t.price.h1 }}</h1>
      <p class="mt-5 lg:mt-8 text-lg lg:text-xl leading-relaxed max-w-[34rem]">{{ t.price.lead }}</p>
      <div class="mt-7 lg:mt-8">{% include "cta-hero.njk" %}</div>
    </div>
  </div>
</section>

<section class="pb-10 lg:pb-14" aria-label="{{ t.stages.heading }}">
  <div class="wrap">{% set pstripNames = true %}{% include "pstrip.njk" %}</div>
</section>

<section class="pb-14 lg:pb-28" aria-labelledby="tiers-h">
  <div class="wrap">
    <h2 id="tiers-h" class="sr-only">{{ t.ui.compareServices }}</h2>
    <p class="font-serif text-xl lg:text-2xl leading-snug text-ink max-w-3xl">{{ t.price.method }}</p>

    <article class="start-card mt-8 lg:mt-12">
      <div class="start-main">
        <p class="step-tag">{{ t.price.startHere }}</p>
        <h3 class="mt-3 font-serif text-3xl lg:text-4xl">{{ t.price.assessment.name }}</h3>
        <p class="mt-4 lg:mt-6"><span class="numeral text-6xl lg:text-7xl text-ink">{{ facts.prices.assessment | ils }}</span></p>
      </div>
      <div class="start-side lg:self-end">
        <p class="font-serif text-xl lg:text-2xl leading-snug text-ink">{{ t.price.credit | fill({ days: facts.credit.windowDays }) }}</p>
        <p class="mt-4 text-lg">{{ t.price.assessment.body }}</p>
        <p class="mt-4"><a class="link font-semibold" href="/en/conditions/">{{ t.price.conditions }} <span class="flip" aria-hidden="true">{{ t.ui.arrow }}</span></a></p>
      </div>
    </article>

    <div class="tiers mt-10 lg:mt-14 grid gap-6 lg:grid-cols-3 lg:gap-0">
      <article class="tier py-7 border-t-2 border-brass lg:border-t-0 lg:border-y lg:border-y-rule lg:border-e lg:border-e-rule lg:pe-8 lg:py-10">
        <h3 class="tier-name font-serif text-2xl lg:text-3xl">{{ t.price.shield.name }}</h3>
        <div class="tier-price"><p class="numeral text-5xl sm:text-6xl lg:text-5xl xl:text-6xl text-ink">{{ facts.prices.personalShield | ils }}</p></div>
        <p class="tier-for text-lg">{{ t.price.shield.for }}</p>
        <ul class="tier-list divide-y divide-rule border-y border-rule">
          {% for i in t.price.shield.items %}<li class="py-3">{{ i }}</li>{% endfor %}
        </ul>
      </article>
      <article class="tier py-7 border-t-2 border-brass lg:border-t-0 lg:border-y lg:border-y-rule lg:border-e lg:border-e-rule lg:px-8 lg:py-10">
        <h3 class="tier-name font-serif text-2xl lg:text-3xl">{{ t.price.two.name }}</h3>
        <div class="tier-price"><p class="numeral text-5xl sm:text-6xl lg:text-5xl xl:text-6xl text-ink">{{ facts.prices.shieldForTwo | ils }}</p></div>
        <p class="tier-for text-lg">{{ t.price.two.for }}</p>
        <ul class="tier-list divide-y divide-rule border-y border-rule">
          {% for i in t.price.two.items %}<li class="py-3">{{ i }}</li>{% endfor %}
        </ul>
      </article>
      <article class="tier py-7 border-t-2 border-brass lg:border-t-0 lg:border-y lg:border-y-rule lg:ps-8 lg:py-10">
        <h3 class="tier-name font-serif text-2xl lg:text-3xl">{{ t.price.inner.name }}</h3>
        <div class="tier-price"><p class="numeral text-5xl sm:text-6xl lg:text-5xl xl:text-6xl text-ink">{{ facts.prices.innerCircle | ils }}</p></div>
        <p class="tier-for text-lg">{{ t.price.inner.for }}</p>
        <ul class="tier-list divide-y divide-rule border-y border-rule">
          {% for i in t.price.inner.items %}<li class="py-3">{{ i }}</li>{% endfor %}
        </ul>
      </article>
    </div>

    <div class="mt-8 grid gap-3 text-muted max-w-3xl">
      <p>{{ t.price.underAll }}</p>
      <p>{{ t.price.larger | fill({ price: facts.prices.largerFrom | ils }) }}</p>
      <p>{{ t.price.care | fill({ price: facts.prices.annualCareFrom | ils }) }} <a class="link font-semibold" href="/en/conditions/">{{ t.price.conditions }} <span class="flip" aria-hidden="true">{{ t.ui.arrow }}</span></a></p>
    </div>
  </div>
</section>

{% set contactNote = '' %}
{% include "contact-block.njk" %}
