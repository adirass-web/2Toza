---
layout: base.njk
title: Pricing — Toza
description: Toza's prices, published. All prices include VAT.
permalink: /en/pricing/index.html
---
<section class="pt-8 pb-10 lg:pt-20 lg:pb-16" aria-labelledby="h1">
  <div class="wrap grid gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h1 id="h1" class="display text-[2.625rem] sm:text-6xl lg:text-[5rem] !text-ink">Prices, published.</h1>
      <p class="mt-5 lg:mt-8 text-lg lg:text-xl leading-relaxed max-w-[34rem]">{{ t.contact.reassurance }}</p>
      <div class="mt-7 lg:mt-8">{% include "cta-hero.njk" %}</div>
    </div>
  </div>
</section>

<section class="pb-14 lg:pb-28" aria-labelledby="tiers-h">
  <div class="wrap">
    <h2 id="tiers-h" class="sr-only">{{ t.ui.compareServices }}</h2>
    <div class="tiers grid gap-6 lg:grid-cols-3 lg:gap-0 lg:border-y lg:border-rule">
      <article class="tier py-7 border-t border-rule lg:border-t-0 lg:pe-10 lg:py-10 lg:border-e lg:border-rule">
        <h3 class="tier-name font-serif text-2xl lg:text-3xl">{{ t.price.assessment.name }}</h3>
        <div class="tier-price"><p class="numeral text-6xl text-ink">{{ facts.prices.assessment | ils }}</p><p class="mt-1 text-muted">{{ t.price.including }}</p></div>
        <ul class="tier-list divide-y divide-rule border-y border-rule">
          {% for i in t.price.assessment.items %}<li class="py-3">{{ i }}</li>{% endfor %}
        </ul>
      </article>
      <article class="tier py-7 border-t-2 border-brass lg:border-t-0 lg:px-10 lg:py-10 lg:border-e lg:border-rule bg-paper-deep/60 px-5">
        <h3 class="tier-name font-serif text-2xl lg:text-3xl">{{ t.price.shield.name }}</h3>
        <div class="tier-price"><p class="numeral text-6xl text-ink">{{ facts.prices.personalShield | ils }}</p><p class="mt-1 text-muted">{{ t.price.including }}</p></div>
        <ul class="tier-list divide-y divide-rule border-y border-rule">
          {% for i in t.price.shield.items %}<li class="py-3">{{ i }}</li>{% endfor %}
        </ul>
      </article>
      <article class="tier py-7 border-t border-rule lg:border-t-0 lg:ps-10 lg:py-10">
        <h3 class="tier-name font-serif text-2xl lg:text-3xl">{{ t.price.inner.name }}</h3>
        <div class="tier-price"><p class="flex items-baseline gap-2"><span class="text-xl text-muted">{{ t.price.from }}</span><span class="numeral text-6xl text-ink">{{ facts.prices.innerCircleFrom | ils }}</span></p><p class="mt-1 text-muted">{{ t.price.including }}</p></div>
        <ul class="tier-list divide-y divide-rule border-y border-rule">
          {% for i in t.price.inner.items %}<li class="py-3">{{ i }}</li>{% endfor %}
        </ul>
      </article>
    </div>
    <div class="mt-10 grid gap-3 lg:grid-cols-12">
      <p class="lg:col-span-7 text-lg">{{ t.price.credit | fill({ days: facts.credit.windowDays }) }}</p>
      <p class="lg:col-span-5 lg:text-end"><a class="link font-semibold" href="#">{{ t.price.conditions }} <span class="flip" aria-hidden="true">{{ t.ui.arrow }}</span></a></p>
    </div>
    <p class="mt-6 text-muted">Larger or different needs are quoted individually.</p>
  </div>
</section>

{% set contactNote = '' %}
{% include "contact-block.njk" %}
